# FalkorDB Configuration
# Leave blank or set to 'auto' to use the dual-mode graph engine (with live fallback).
# For real FalkorDB (Docker or Cloud):
# FALKORDB_URL=falkor://localhost:6379
# FALKORDB_URL=falkor://default:password@falkordb-cloud-host:6379
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_URL=

# App Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Multi-Tenant defaults
DEFAULT_TENANT=nexus_corp
