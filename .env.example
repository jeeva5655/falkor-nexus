# FalkorDB Configuration
# Leave blank or set to 'auto' to use the dual-mode graph engine (with live fallback).
# For real FalkorDB (Docker or Cloud):
# FALKORDB_URL=falkor://localhost:6379
# FALKORDB_URL=falkor://default:password@falkordb-cloud-host:6379
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_URL=

# App Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Multi-Tenant defaults
DEFAULT_TENANT=nexus_corp

# Optional: Real LLM Dynamic Reasoning (OpenAI / Ollama / Gemini)
# If left blank, FalkorNexus uses its native autonomous graph reasoning engine out-of-the-box!
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
GEMINI_API_KEY=
